# Copy to mobile/.env (git-ignored). Read by app.config.ts at build time.

# Working name (docs/01-biznes-qoidalar.md §13, question 1). Not final.
APP_NAME=GTM
APP_NAME_EXPANSION="Get the money"

# Not chosen yet (§13). Placeholders for local development builds only.
# APP_BUNDLE_ID cannot be changed after the first store release.
APP_DOMAIN=localhost
APP_BUNDLE_ID=com.example.app.dev
APP_SLUG=app

# Filled by `npx eas-cli init` once the Expo project exists.
EAS_PROJECT_ID=
