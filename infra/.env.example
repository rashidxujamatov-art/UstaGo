# Copy to infra/.env and replace every "change-me" value.
# infra/.env is git-ignored. Use the same values in backend/.env.

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
POSTGRES_PORT=5432

REDIS_PASSWORD=change-me
REDIS_PORT=6379

# At least 8 characters each.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-too
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=uploads
