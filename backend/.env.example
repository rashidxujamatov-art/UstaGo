# Copy to backend/.env. backend/.env is git-ignored; secrets live only there.
# Passwords must match infra/.env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Working name and domain (docs/01-biznes-qoidalar.md §13, question 1). Not final.
APP_NAME=GTM
APP_DOMAIN=localhost

DATABASE_URL=postgresql://app:change-me@localhost:5432/app?schema=public
REDIS_URL=redis://:change-me@localhost:6379/0

# Set to true behind Nginx/Caddy so rate limits see real client IPs.
TRUST_PROXY=false

# Comma-separated browser origins for the future admin web; empty disables CORS.
CORS_ORIGINS=

# Sessions. Generate the secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# PINFL encryption (32 bytes, base64: openssl rand -base64 32) and HMAC key (openssl rand -base64 48).
PINFL_ENC_KEY=
PINFL_HMAC_KEY=

# External services. mock = local/test adapters; production refuses mocks.
SMS_PROVIDER=mock
# Required when SMS_PROVIDER=eskiz.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=
IDENTITY_PROVIDER=mock
# Self-employed check: mock verifies locally (PINFL ending in 0 goes to the admin queue);
# manual sends every request to the admin queue (use it in production until an API exists).
TAX_PROVIDER=mock

# Maps proxy (Google Geocoding / Places). mock needs no key.
MAPS_PROVIDER=mock
GOOGLE_MAPS_SERVER_KEY=

# Photos: s3 = MinIO locally (credentials from infra/.env), mock = in memory (tests).
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
# Host the phone uses for uploads: http://10.0.2.2:9000 (Android emulator),
# http://<computer LAN IP>:9000 (phone on the same Wi-Fi), http://localhost:9000 (web preview).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Push notifications. Only mock until a Firebase project exists.
PUSH_PROVIDER=mock

# Fixed SMS code 000000. Works only with NODE_ENV=development.
OTP_TEST_MODE=false

# Payouts stay off until the legal scheme is approved (docs/01-biznes-qoidalar.md §14).
FEATURE_PAYOUTS_ENABLED=false
# Only mock until a payout provider is chosen.
PAYOUT_PROVIDER=mock

# Payme merchant: id and key from the Payme business cabinet. Without the key every Payme
# callback is refused. Sandbox checkout: https://test.paycom.uz
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# Click merchant: ids and secret key from the Click merchant cabinet.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Saved cards (BY5, BJ6, BJ7): mock locally (SMS code 000000), payme = Payme Subscribe API.
CARD_PROVIDER=mock
PAYME_SUBSCRIBE_URL=https://checkout.paycom.uz/api
# 32 random bytes, base64: openssl rand -base64 32
CARD_TOKEN_ENC_KEY=
# Finish Click / Payme payments without the provider app. Works only with NODE_ENV=development.
PAYMENT_TEST_MODE=false
