// Database schema. Conventions (docs/02-arxitektura.md §5):
// - money columns are BIGINT in tiyin (1 so'm = 100 tiyin), percentages are bps;
// - timestamps are TIMESTAMPTZ in UTC;
// - tables and columns are snake_case, Prisma models are PascalCase/camelCase.
// Tables are added stage by stage.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Super-admin settings (docs/01-biznes-qoidalar.md §12). One row per key.
/// `value` is validated by src/modules/settings/settings.schema.ts;
/// money values are stored as decimal strings of tiyin to stay exact.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// User who made the last change; null for values written by the seed.
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("settings")
}

enum Language {
  uz
  ru
  en
  tg
}

enum ThemeMode {
  LIGHT
  DARK
  AUTO
}

enum Role {
  CUSTOMER
  EXECUTOR
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum StaffRole {
  ADMIN
  SUPER_ADMIN
}

enum DocType {
  ID_CARD
  PASSPORT
}

enum ConsentType {
  TERMS
  PERSONAL_DATA
  BIOMETRY
  LOCATION
}

enum InviteCodeKind {
  PLATFORM
}

/// An account. Created only after the phone number is confirmed by SMS; until MyID
/// succeeds it has no `identity` and cannot use the marketplace (docs/01 §2).
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// E.164, e.g. +998901234567.
  phone           String     @unique
  /// Stored lower-case.
  email           String     @unique
  passwordHash    String     @map("password_hash")
  lang            Language   @default(uz)
  theme           ThemeMode  @default(AUTO)
  /// Null until the role is chosen on K4.
  activeRole      Role?      @map("active_role")
  status          UserStatus @default(ACTIVE)
  referralCode    String     @unique @map("referral_code")
  /// L1 of the referral chain. Null only for users who came with a platform code (§2).
  referrerId      String?    @map("referrer_id") @db.Uuid
  inviteCodeId    String?    @map("invite_code_id") @db.Uuid
  phoneVerifiedAt DateTime   @map("phone_verified_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  referrer        User?            @relation("Referrals", fields: [referrerId], references: [id], onDelete: Restrict)
  referrals       User[]           @relation("Referrals")
  inviteCode      InviteCode?      @relation(fields: [inviteCodeId], references: [id], onDelete: Restrict)
  identity        Identity?
  staff           StaffPermission?
  executorProfile ExecutorProfile?
  consents        Consent[]
  devices         Device[]
  sessions        Session[]
  customerOrders  Order[]          @relation("CustomerOrders")
  executorOrders  Order[]          @relation("ExecutorOrders")
  permissionRequests PermissionRequest[]
  broadcasts         Broadcast[]

  @@index([referrerId])
  @@map("users")
}

/// Result of the MyID check. The face image is never stored (CLAUDE.md rule 9).
model Identity {
  userId     String   @id @map("user_id") @db.Uuid
  /// HMAC-SHA256 of the PINFL: one person = one account.
  pinflHash  String   @unique @map("pinfl_hash")
  /// AES-256-GCM encrypted PINFL (iv | tag | ciphertext).
  pinflEnc   Bytes    @map("pinfl_enc")
  lastName   String   @map("last_name")
  firstName  String   @map("first_name")
  middleName String?  @map("middle_name")
  birthDate  DateTime @map("birth_date") @db.Date
  docType    DocType  @map("doc_type")
  myidRef    String   @map("myid_ref")
  verifiedAt DateTime @default(now()) @map("verified_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("identities")
}

model Consent {
  id         String      @id @default(uuid(7)) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  type       ConsentType
  version    String
  acceptedAt DateTime    @default(now()) @map("accepted_at") @db.Timestamptz(3)
  /// Client device id the consent was given on.
  deviceId   String      @map("device_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("consents")
}

/// ADMIN / SUPER_ADMIN roles. Super admins are granted only through the CLI (§1).
model StaffPermission {
  userId      String    @id @map("user_id") @db.Uuid
  role        StaffRole
  permissions String[]  @default([])
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_permissions")
}

/// Created the first time the EXECUTOR role is activated; starts the free period (§8).
model ExecutorProfile {
  userId          String     @id @map("user_id") @db.Uuid
  freePeriodStart DateTime   @map("free_period_start") @db.Timestamptz(3)
  freePeriodEnd   DateTime   @map("free_period_end") @db.Timestamptz(3)
  /// Tax method status (§9); after the free period only VERIFIED may take new jobs.
  taxStatus       TaxStatus  @default(NONE) @map("tax_status")
  /// The method the status refers to (the verified one, or the one waiting for a check).
  taxMethod       TaxMethod? @map("tax_method")
  /// Self-employed certificate end; null for Xolis (docs/01 §9).
  taxValidUntil   DateTime?  @map("tax_valid_until") @db.Timestamptz(3)
  taxCheckedAt    DateTime?  @map("tax_checked_at") @db.Timestamptz(3)
  /// BJ9 "Muddat tugashidan 7 kun oldin eslatish".
  taxReminders    Boolean    @default(true) @map("tax_reminders")
  /// taxValidUntil the expiry reminder was sent for (one reminder per certificate).
  taxRemindedFor  DateTime?  @map("tax_reminded_for") @db.Timestamptz(3)
  /// Paynet Xolis QR the customers pay to (BY9) and the phone registered in Xolis (BJ10).
  xolisQr         String?    @map("xolis_qr")
  xolisPhone      String?    @map("xolis_phone")
  /// free_period_reminder_days already pushed (§8).
  remindedDays    Int[]      @default([]) @map("free_period_reminded_days")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("executor_profiles")
}

/// Platform invite codes created by the super admin (or the CLI) for the first users
/// and campaigns. Users who sign up with one have no L1 (§2).
model InviteCode {
  id        String         @id @default(uuid(7)) @db.Uuid
  code      String         @unique
  kind      InviteCodeKind @default(PLATFORM)
  /// Null when created from the CLI.
  createdBy String?        @map("created_by") @db.Uuid
  /// Null = unlimited.
  maxUses   Int?           @map("max_uses")
  used      Int            @default(0)
  expiresAt DateTime?      @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  users User[]

  @@map("invite_codes")
}

/// A phone the user signed in from. A device becomes trusted after an SMS check;
/// signing in from an untrusted device asks for an SMS code (§2).
model Device {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// Random id generated by the app and kept in secure storage.
  deviceId   String    @map("device_id")
  name       String?
  platform   String
  trustedAt  DateTime? @map("trusted_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// FCM registration token for push notifications.
  pushToken  String?   @map("push_token")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([userId, deviceId])
  @@map("devices")
}

/// Refresh-token session. Only a SHA-256 hash of the token is stored. Each refresh
/// rotates the token; presenting a rotated token again revokes every session (§10).
model Session {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceRowId  String    @map("device_row_id") @db.Uuid
  refreshHash  String    @unique @map("refresh_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Set when the session was rotated; its token must never be used again.
  replacedById String?   @map("replaced_by_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceRowId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Admin, super-admin and money actions (CLAUDE.md rule 10). Append-only.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Null for actions run by the system or the CLI.
  actorId    String?  @map("actor_id") @db.Uuid
  actorType  String   @map("actor_type")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  data       Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum TaxStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum TaxMethod {
  SELF_EMPLOYED
  XOLIS
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationSource {
  AUTO
  MANUAL
}

/**
 * One tax-method request (BJ8-BJ10): checked automatically against the tax system, or
 * queued for an admin (AD1 "Hujjat murojaatlari"). Xolis has no API, so it is always manual.
 */
model TaxVerification {
  id         String             @id @default(uuid(7)) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  method     TaxMethod
  status     VerificationStatus @default(PENDING)
  source     VerificationSource
  /// Photo of the self-employed certificate (manual check).
  fileKey    String?            @map("file_key")
  xolisQr    String?            @map("xolis_qr")
  xolisPhone String?            @map("xolis_phone")
  validUntil DateTime?          @map("valid_until") @db.Timestamptz(3)
  reviewerId String?            @map("reviewer_id") @db.Uuid
  /// Why an admin rejected it; shown to the executor.
  reason     String?
  checkedAt  DateTime?          @map("checked_at") @db.Timestamptz(3)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("tax_verifications")
}

// ---------------------------------------------------------------------------
// Orders (docs/01-biznes-qoidalar.md §3)
// ---------------------------------------------------------------------------

enum OrderStatus {
  PUBLISHED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  DONE_BY_EXECUTOR
  COMPLETED
  PAID
  CANCELLED
  DISPUTED
}

enum PaymentMethod {
  BALANCE
  CLICK
  PAYME
  CARD
  CASH
  XOLIS_QR
}

/// Why an order was cancelled. EXPIRED is set by the system (§3.3); DISPUTE by an admin's
/// dispute decision (stage 7); ADMIN by a plain moderation cancel.
enum CancelReason {
  NOT_NEEDED
  FOUND_OTHER
  EXECUTOR_LATE
  NO_AGREEMENT
  OTHER
  EXPIRED
  DISPUTE
  ADMIN
}

/// Stage 7 dispute resolution (docs/01 §5, AD3). No refunds: PARTIAL shrinks the order's own
/// price before anything has been charged; nothing is reversed.
enum DisputeDecision {
  FULL
  PARTIAL
  CANCEL
}

/// FULL executes at once (nothing to review). PARTIAL / CANCEL wait for a super admin.
enum DisputeApproval {
  NONE
  PENDING
  APPROVED
  REJECTED
}

/// Service types (Elektrik, Santexnik, ...). Names in four languages.
model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  /// { "uz": "...", "ru": "...", "en": "...", "tg": "..." }
  names     Json
  /// Icon key the app maps to an icon (lucide name).
  icon      String
  /// Accent color of the icon tile (hex).
  color     String
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  orders Order[]

  @@map("categories")
}

model Order {
  id                 String                                 @id @default(uuid(7)) @db.Uuid
  /// Human-friendly number (#1024). Starts at 1001.
  number             Int                                    @unique @default(autoincrement())
  customerId         String                                 @map("customer_id") @db.Uuid
  executorId         String?                                @map("executor_id") @db.Uuid
  categoryId         String                                 @map("category_id") @db.Uuid
  title              String
  description        String
  /// Object-storage keys of up to order_photos_max photos.
  photoKeys          String[]                               @default([]) @map("photo_keys")
  addressText        String                                 @map("address_text")
  lat                Float
  lng                Float
  /// PostGIS point for radius search; written together with lat/lng.
  location           Unsupported("geography(Point, 4326)")?
  entrance           String?
  floor              String?
  apartment          String?
  landmark           String?
  timeFrom           DateTime                               @map("time_from") @db.Timestamptz(3)
  timeTo             DateTime                               @map("time_to") @db.Timestamptz(3)
  /// Tiyin.
  price              BigInt
  paymentMethod      PaymentMethod                          @map("payment_method")
  status             OrderStatus                            @default(PUBLISHED)
  // Rates copied at acceptance (CLAUDE.md rule 7).
  feeBpsSnapshot     Int?                                   @map("fee_bps_snapshot")
  refL1BpsSnapshot   Int?                                   @map("ref_l1_bps_snapshot")
  refL2BpsSnapshot   Int?                                   @map("ref_l2_bps_snapshot")
  /// Service fee computed at acceptance (§4, §6), tiyin.
  fee                BigInt?
  feeDemo            BigInt?                                @map("fee_demo")
  feeReal            BigInt?                                @map("fee_real")
  finishPhotoKeys    String[]                               @default([]) @map("finish_photo_keys")
  createdAt          DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  acceptedAt         DateTime?                              @map("accepted_at") @db.Timestamptz(3)
  departedAt         DateTime?                              @map("departed_at") @db.Timestamptz(3)
  arrivedAt          DateTime?                              @map("arrived_at") @db.Timestamptz(3)
  startedAt          DateTime?                              @map("started_at") @db.Timestamptz(3)
  /// Executor pressed "Ishni tugatdim".
  finishedAt         DateTime?                              @map("finished_at") @db.Timestamptz(3)
  /// Customer confirmed the cash / Xolis payment.
  customerPaidAt     DateTime?                              @map("customer_paid_at") @db.Timestamptz(3)
  /// Executor confirmed receiving the cash / Xolis payment.
  executorReceivedAt DateTime?                              @map("executor_received_at") @db.Timestamptz(3)
  paidAt             DateTime?                              @map("paid_at") @db.Timestamptz(3)
  /// "Pul kelmadi" / "Muammo bor" (§5.1): who opened the dispute, when and why.
  disputedAt         DateTime?                              @map("disputed_at") @db.Timestamptz(3)
  disputedBy         String?                                @map("disputed_by") @db.Uuid
  disputeNote        String?                                @map("dispute_note")
  /// Stage 7 (AD3): the admin's proposal and its outcome. Reset to null whenever a fresh
  /// dispute is opened, so a later cycle on the same order starts clean.
  disputeDecision     DisputeDecision? @map("dispute_decision")
  disputeDecisionNote String?          @map("dispute_decision_note")
  disputeDecidedBy    String?          @map("dispute_decided_by") @db.Uuid
  disputeDecidedAt    DateTime?        @map("dispute_decided_at") @db.Timestamptz(3)
  disputeApproval     DisputeApproval  @default(NONE) @map("dispute_approval")
  disputeApprovedBy   String?          @map("dispute_approved_by") @db.Uuid
  disputeApprovedAt   DateTime?        @map("dispute_approved_at") @db.Timestamptz(3)
  disputeRejectReason String?          @map("dispute_reject_reason")
  /// Snapshot of `price` before a PARTIAL decision shrank it (display only, AD3).
  disputeOriginalPrice BigInt?         @map("dispute_original_price")
  disputeExecutedAt   DateTime?        @map("dispute_executed_at") @db.Timestamptz(3)
  /// confirm_reminder_hours already pushed to the customer / executor (§5.1).
  customerReminded   Int[]                                  @default([]) @map("customer_reminded_hours")
  executorReminded   Int[]                                  @default([]) @map("executor_reminded_hours")
  cancelledAt        DateTime?                              @map("cancelled_at") @db.Timestamptz(3)
  /// Null when cancelled by the system.
  cancelledBy        String?                                @map("cancelled_by") @db.Uuid
  cancelReason       CancelReason?                          @map("cancel_reason")
  cancelNote         String?                                @map("cancel_note")
  updatedAt          DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer User         @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  executor User?        @relation("ExecutorOrders", fields: [executorId], references: [id], onDelete: Restrict)
  category Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  events   OrderEvent[]
  messages Message[]
  holds    WalletHold[]
  trips    Trip[]

  @@index([status, timeTo])
  @@index([customerId])
  @@index([executorId])
  @@index([location], type: Gist)
  @@map("orders")
}

/// Every status change: who, when, from, to (§3.3).
model OrderEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  /// Null for system actions.
  actorId    String?      @map("actor_id") @db.Uuid
  at         DateTime     @default(now()) @db.Timestamptz(3)
  payload    Json?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, at])
  @@map("order_events")
}

enum MessageKind {
  TEXT
  PHOTO
  /// Status notes in the chat ("Usta ishni boshladi").
  SYSTEM
}

/// Order chat (BY4), open to the two parties after acceptance.
model Message {
  id         String      @id @default(uuid(7)) @db.Uuid
  orderId    String      @map("order_id") @db.Uuid
  /// Null for SYSTEM messages.
  senderId   String?     @map("sender_id") @db.Uuid
  /// Executor of the conversation: if a job is declined and taken by someone else,
  /// the new executor does not see the earlier chat.
  executorId String      @map("executor_id") @db.Uuid
  kind       MessageKind
  text       String?
  photoKey   String?     @map("photo_key")
  /// SYSTEM messages carry a code; the app shows it in the reader's language.
  systemCode String?     @map("system_code")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt     DateTime?   @map("read_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, executorId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Wallet and ledger (docs/01-biznes-qoidalar.md §7, CLAUDE.md rules 1-3)
// ---------------------------------------------------------------------------

enum WalletAccountKind {
  REAL
  DEMO
  PLATFORM_REVENUE
  PLATFORM_MARKETING
  PAYOUT_PROVIDER_FEES
  /// Demo money spent on service fees; not revenue.
  DEMO_SINK
  /// Source of demo bonuses; its negative balance is the demo money in circulation.
  DEMO_ISSUANCE
  PAYMENT_CLEARING
  PAYOUT_CLEARING
}

/// One account per owner and kind. `ownerKey` is the user id, or "PLATFORM".
model WalletAccount {
  id        String            @id @default(uuid(7)) @db.Uuid
  ownerKey  String            @map("owner_key")
  kind      WalletAccountKind
  /// Cached sum of the entries, tiyin. Changed only by the ledger service.
  balance   BigInt            @default(0)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@unique([ownerKey, kind])
  @@map("wallet_accounts")
}

/// A balanced set of entries (their amounts sum to 0).
model LedgerTransaction {
  id             String   @id @default(uuid(7)) @db.Uuid
  type           String
  orderId        String?  @map("order_id") @db.Uuid
  /// Top-ups and order payments: the provider payment behind the posting.
  paymentId      String?  @map("payment_id") @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key")
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String @id @default(uuid(7)) @db.Uuid
  transactionId String @map("transaction_id") @db.Uuid
  accountId     String @map("account_id") @db.Uuid
  /// Tiyin; positive = credit to the account, negative = debit.
  amount        BigInt

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     WalletAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@map("ledger_entries")
}

enum HoldStatus {
  ACTIVE
  SETTLED
  RELEASED
}

/// Service fee reserved when a job is accepted (§4). Not an account and not a money
/// movement: it only lowers what the executor has available.
model WalletHold {
  id         String     @id @default(uuid(7)) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  /**
   * One ACTIVE hold per order; released holds stay for history (a declined job can be taken again).
   */
  orderId    String     @map("order_id") @db.Uuid
  amountDemo BigInt     @map("amount_demo")
  amountReal BigInt     @map("amount_real")
  status     HoldStatus @default(ACTIVE)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  closedAt   DateTime?  @map("closed_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([orderId])
  @@map("wallet_holds")
}

/// Google Maps Platform requests, for the monthly free-limit view (SA6).
enum WithdrawalStatus {
  REQUESTED
  PROCESSING
  PAID
  FAILED
}

/**
 * Payout to the user's card (docs/01-biznes-qoidalar.md §7). The amount and the bank fee
 * leave the REAL account when requested; FAILED returns both. Card and payout provider
 * come with stage 4, behind the payout feature flag (§14).
 */
model Withdrawal {
  id             String           @id @default(uuid(7)) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  /// Tiyin, whole so'm.
  amount         BigInt
  /// Bank transfer fee (withdraw_fee_bps), tiyin; goes to PAYOUT_PROVIDER_FEES.
  fee            BigInt
  feeBps         Int              @map("fee_bps")
  status         WithdrawalStatus @default(REQUESTED)
  idempotencyKey String           @unique @map("idempotency_key")
  /// Destination card (BJ7).
  cardId         String?          @map("card_id") @db.Uuid
  /// Payout provider reference.
  providerRef    String?          @map("provider_ref")
  processedAt    DateTime?        @map("processed_at") @db.Timestamptz(3)
  failureReason  String?          @map("failure_reason")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@map("withdrawals")
}

// ---------------------------------------------------------------------------
// Payments (docs/01-biznes-qoidalar.md §5, §7; docs/02-arxitektura.md §9)
// ---------------------------------------------------------------------------

enum PaymentProvider {
  PAYME
  CLICK
  CARD
}

enum PaymentPurpose {
  TOPUP
  ORDER
}

/// CREATED: link or QR issued; PENDING: the provider opened its transaction (Payme
/// CreateTransaction, Click Prepare); PAID: money booked; REFUNDED: cancelled after PAID.
enum PaymentStatus {
  CREATED
  PENDING
  PAID
  CANCELLED
  REFUNDED
  EXPIRED
}

/**
 * One attempt to pay through a provider: a top-up (BJ6) or an order (BY5, the BJ4 QR).
 * The provider sees our id as its account field (Payme `payment_id`, Click
 * `merchant_trans_id`), so a callback always resolves to exactly one row.
 */
model Payment {
  id                String          @id @default(uuid(7)) @db.Uuid
  /// Numeric id for providers that want an integer (Click merchant_prepare_id).
  seq               Int             @unique @default(autoincrement())
  provider          PaymentProvider
  purpose           PaymentPurpose
  /// Who pays: the top-up owner or the order's customer.
  userId            String          @map("user_id") @db.Uuid
  orderId           String?         @map("order_id") @db.Uuid
  /// The executor who showed the QR (BJ4); null when the payer started it.
  createdBy         String?         @map("created_by") @db.Uuid
  /// Tiyin; the provider must pay exactly this amount.
  amount            BigInt
  status            PaymentStatus   @default(CREATED)
  /// Payme transaction id, Click click_trans_id or card receipt id.
  providerTxnId     String?         @map("provider_txn_id")
  /// When the provider transaction was opened on our side (Payme create_time).
  providerCreatedAt DateTime?       @map("provider_created_at") @db.Timestamptz(3)
  performedAt       DateTime?       @map("performed_at") @db.Timestamptz(3)
  cancelledAt       DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  /// Payme cancel reason or Click error code.
  cancelReason      Int?            @map("cancel_reason")
  cardId            String?         @map("card_id") @db.Uuid
  /// The link / QR stops working after this (qr_payment_ttl_sec for BJ4).
  expiresAt         DateTime        @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, providerTxnId])
  @@index([orderId])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("payments")
}

enum CardBrand {
  UZCARD
  HUMO
  VISA
  MASTERCARD
}

/**
 * A bank card saved through the card provider (BY5, BJ6, BJ7). Only the provider token is
 * kept, encrypted (CARD_TOKEN_ENC_KEY); never the full number.
 */
model Card {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  provider   String
  tokenEnc   Bytes     @map("token_enc")
  /// "8600 **** **** 4417".
  maskedPan  String    @map("masked_pan")
  brand      CardBrand
  /// MM/YY.
  expire     String
  /// Set after the SMS code check; unverified cards are not offered.
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("cards")
}

model MapsUsage {
  id   String   @id @default(uuid(7)) @db.Uuid
  kind String
  at   DateTime @default(now()) @db.Timestamptz(3)

  @@index([kind, at])
  @@map("maps_usage")
}

/// Why sharing stopped (docs/01 §10).
enum TripEndReason {
  ARRIVED
  NEAR_DESTINATION
  CANCELLED
  DECLINED
  MAX_DURATION
  STOPPED
}

/// Live location while the pro is "Yo'lga chiqdim" (docs/01 §10, docs/02 §5). An order may
/// have more than one over its life (declined and retaken); at most one has `endedAt` null.
model Trip {
  id                 String         @id @default(uuid(7)) @db.Uuid
  orderId            String         @map("order_id") @db.Uuid
  executorId         String         @map("executor_id") @db.Uuid
  startedAt          DateTime       @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt            DateTime?      @map("ended_at") @db.Timestamptz(3)
  endReason          TripEndReason? @map("end_reason")
  /// Last ETA from MapsProvider.route(), throttled by eta_refresh_sec / route_deviation_m (§10).
  lastEtaSec         Int?           @map("last_eta_sec")
  lastDistanceM      Int?           @map("last_distance_m")
  lastRouteAt        DateTime?      @map("last_route_at") @db.Timestamptz(3)
  /// [[lat,lng], ...] of the last computed route; used to detect a deviation.
  lastRoutePolyline  Json?          @map("last_route_polyline")
  /// Anchor point of the last ETA computation, used for deviation when there is no polyline.
  lastRouteOriginLat Float?         @map("last_route_origin_lat")
  lastRouteOriginLng Float?         @map("last_route_origin_lng")

  order  Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  points TripPoint[]

  @@index([orderId])
  @@index([orderId, endedAt])
  @@map("trips")
}

/// Every point sent while sharing (docs/02 §5); deleted after track_retention_days.
model TripPoint {
  id        String                                @id @default(uuid(7)) @db.Uuid
  tripId    String                                @map("trip_id") @db.Uuid
  at        DateTime                              @db.Timestamptz(3)
  location  Unsupported("geography(Point, 4326)")
  accuracyM Float?                                @map("accuracy_m")
  speed     Float?
  heading   Float?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, at])
  @@map("trip_points")
}

enum PermissionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// AD1 "Ruxsat so'rash" → SA3 inbox (stage 7). An admin asks for one more permission key.
model PermissionRequest {
  id          String                  @id @default(uuid(7)) @db.Uuid
  requestedBy String                  @map("requested_by") @db.Uuid
  permission  String
  note        String?
  status      PermissionRequestStatus @default(PENDING)
  decidedBy   String?                 @map("decided_by") @db.Uuid
  decidedAt   DateTime?               @map("decided_at") @db.Timestamptz(3)
  reason      String?
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  requester User @relation(fields: [requestedBy], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("permission_requests")
}

enum BroadcastTarget {
  ALL
  CUSTOMER
  EXECUTOR
}

enum BroadcastStatus {
  QUEUED
  SENDING
  DONE
}

/// A push + in-app broadcast sent from AD1/§7 (notifications.broadcast). `title`/`body`
/// carry all four languages, supplied by the admin — not an i18n key (there is no fixed
/// catalog entry for free-form admin text).
model Broadcast {
  id              String          @id @default(uuid(7)) @db.Uuid
  target          BroadcastTarget
  title           Json
  body            Json
  createdBy       String          @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  recipientsCount Int             @default(0) @map("recipients_count")
  status          BroadcastStatus @default(QUEUED)

  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("broadcasts")
}
